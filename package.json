{
  "name": "dockerfile-missing-user-companion",
  "displayName": "Dockerfile Missing USER Companion",
  "description": "Warns when a Dockerfile's final build stage never sets a non-root USER (containers run as root by default).",
  "version": "0.1.0",
  "publisher": "GapHunterLabs",
  "icon": "images/icon.png",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Linters"
  ],
  "keywords": [
    "dockerfile",    "docker",    "security",    "linter",    "rootless"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GapHunterLabs/vscode-dockerfile-missing-user-companion.git"
  },
  "bugs": {
    "url": "https://github.com/GapHunterLabs/vscode-dockerfile-missing-user-companion/issues"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "test": "tsc -p ./ && node --test \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.2"
  }
}
